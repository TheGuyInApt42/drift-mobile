+    /**
+     * Patched: the plugin had no destroy handling, so swiping the app away left
+     * ExoPlayer playing (the foreground service kept the process alive) and the
+     * MediaSession active. Release everything with the Activity.
+     */
+    @Override
+    protected void handleOnDestroy() {
+        try {
+            if (audioAssetList != null) {
+                for (AudioAsset audio : audioAssetList.values()) {
+                    try {
+                        audio.unload();
+                    } catch (Exception e) {
+                        Log.e(TAG, "Error unloading on destroy", e);
+                    }
+                }
+                audioAssetList.clear();
+            }
+            clearNotification();
+            currentlyPlayingAssetId = null;
+            if (mediaSession != null) {
+                mediaSession.setActive(false);
+                mediaSession.release();
+                mediaSession = null;
+            }
+        } catch (Exception ex) {
+            Log.e(TAG, "Error in handleOnDestroy", ex);
+        }
+        super.handleOnDestroy();
+    }
